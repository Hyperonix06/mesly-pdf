<UserControl x:Class="MeslyPdfReader.App.Views.Screens.HomeScreen"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MeslyPdfReader.App.ViewModels">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24,28,24" MaxWidth="1100" HorizontalAlignment="Left">
            <!-- Hoş Geldiniz -->
            <Border Style="{StaticResource Card}" Padding="0" ClipToBounds="True" Height="190">
                <Grid>
                    <!-- Sağdaki kırmızı dalgalar ve belge görseli -->
                    <Canvas HorizontalAlignment="Right" Width="440" Height="190" ClipToBounds="True">
                        <Path Data="M 120,0 C 220,40 200,150 300,190 L 440,190 L 440,0 Z">
                            <Path.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#FF4D4F" Offset="0" /><GradientStop Color="#C4191A" Offset="1" /></LinearGradientBrush></Path.Fill>
                        </Path>
                        <Path Data="M 60,0 C 170,60 150,160 250,190 L 300,190 C 200,150 220,40 120,0 Z" Fill="#33E53935" />
                        <Path Data="M 175,0 C 260,50 250,140 340,190 L 360,190 C 270,140 280,50 195,0 Z" Fill="#55FFFFFF" />
                        <!-- Belge -->
                        <Grid Canvas.Left="300" Canvas.Top="36" Width="92" Height="118" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform><RotateTransform Angle="-8" /></Grid.RenderTransform>
                            <Border Background="White" CornerRadius="6">
                                <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.25" /></Border.Effect>
                            </Border>
                            <StackPanel Margin="12,14,12,0">
                                <Border Height="10" CornerRadius="2" Background="#E53935" Width="44" HorizontalAlignment="Left" />
                                <Border Height="5" CornerRadius="2" Background="#F4B4B4" Margin="0,10,0,0" />
                                <Border Height="5" CornerRadius="2" Background="#F4B4B4" Margin="0,6,0,0" />
                                <Border Height="5" CornerRadius="2" Background="#F4B4B4" Margin="0,6,14,0" />
                                <Border Height="5" CornerRadius="2" Background="#F4B4B4" Margin="0,6,0,0" />
                                <Border Height="5" CornerRadius="2" Background="#F4B4B4" Margin="0,6,24,0" />
                            </StackPanel>
                        </Grid>
                    </Canvas>
                    <StackPanel Margin="28,0,0,0" VerticalAlignment="Center" MaxWidth="460" HorizontalAlignment="Left">
                        <TextBlock Text="Hoş Geldiniz" FontFamily="{StaticResource MeslyDisplayFont}" FontSize="30" FontWeight="SemiBold" />
                        <TextBlock Margin="0,10,0,0" TextWrapping="Wrap" FontSize="14" Foreground="{DynamicResource MeslyMutedTextBrush}"
                                   Text="Mesly Pdf Reader ile PDF belgelerinizi kolayca okuyun, düzenleyin, dönüştürün ve metne çevirin." />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Görev kutuları -->
            <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                <Button Style="{StaticResource TaskBox}" Command="{Binding OpenCommand}" ToolTip="Bir PDF belgesi seçip görüntüleyin (Ctrl+O)">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="32" Foreground="{DynamicResource MeslyAccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="PDF Aç" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Belge görüntüle" FontSize="11.5" Foreground="{DynamicResource MeslyMutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TaskBox}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Ocr}" ToolTip="Taranmış belge veya resimdeki metni tanıyın">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="ScanText24" FontSize="32" Foreground="{DynamicResource MeslyAccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="OCR" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Metin tanıma" FontSize="11.5" Foreground="{DynamicResource MeslyMutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TaskBox}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Convert}" ToolTip="PDF'yi Word, Excel, PowerPoint, resim veya metne çevirin">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="DocumentArrowRight24" FontSize="32" Foreground="{DynamicResource MeslyAccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Dönüştür" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="PDF'yi Office veya resme çevir" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MeslyMutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource TaskBox}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Scan}" ToolTip="Kağıt belgeyi tarayıp PDF'e aktarın">
                    <StackPanel>
                        <ui:SymbolIcon Symbol="Scan24" FontSize="32" Foreground="{DynamicResource MeslyAccentBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="Tarama" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" Margin="0,8,0,0" />
                        <TextBlock Text="Kağıt belgeyi PDF'e aktar" FontSize="11.5" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource MeslyMutedTextBrush}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Hızlı Erişim + Gösterge Paneli -->
            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Hızlı Erişim" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Margin="0,0,0,8" Height="38" Click="Recent_Click" ToolTip="Son kullanılan belgeler">
                            <DockPanel LastChildFill="False" Width="320">
                                <ui:SymbolIcon Symbol="History24" FontSize="16" Foreground="{DynamicResource MeslyAccentBrush}" Margin="0,0,10,0" />
                                <TextBlock VerticalAlignment="Center"><Run Text="Son Belgeler (" /><Run Text="{Binding Library.RecentCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronRight24" FontSize="14" />
                            </DockPanel>
                        </Button>
                        <Button Style="{StaticResource SecondaryButton}" HorizontalContentAlignment="Stretch" Height="38" Click="Favorites_Click" ToolTip="Yıldızladığınız belgeler">
                            <DockPanel LastChildFill="False" Width="320">
                                <ui:SymbolIcon Symbol="Star24" Filled="True" FontSize="16" Foreground="{DynamicResource MeslyAccentBrush}" Margin="0,0,10,0" />
                                <TextBlock VerticalAlignment="Center"><Run Text="Sık Kullanılanlar (" /><Run Text="{Binding Library.FavoriteCount, Mode=OneWay}" /><Run Text=")" /></TextBlock>
                                <ui:SymbolIcon DockPanel.Dock="Right" Symbol="ChevronRight24" FontSize="14" />
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>
                <Border Grid.Column="2" Style="{StaticResource Card}" Background="{DynamicResource MeslySubtleBrush}">
                    <StackPanel>
                        <TextBlock Text="Gösterge Paneli" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10" />
                        <UniformGrid Columns="3">
                            <StackPanel>
                                <TextBlock Text="{Binding Library.MonthOpened}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource MeslyAccentBrush}" />
                                <TextBlock Text="belge açıldı" FontSize="12" Foreground="{DynamicResource MeslyMutedTextBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Library.MonthConverted}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource MeslyAccentBrush}" />
                                <TextBlock Text="dönüştürme" FontSize="12" Foreground="{DynamicResource MeslyMutedTextBrush}" />
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="{Binding Library.MonthOcr}" FontSize="26" FontWeight="SemiBold" Foreground="{DynamicResource MeslyAccentBrush}" />
                                <TextBlock Text="OCR işlemi" FontSize="12" Foreground="{DynamicResource MeslyMutedTextBrush}" />
                            </StackPanel>
                        </UniformGrid>
                        <TextBlock Text="Bu ayın sayıları" FontSize="11" Foreground="{DynamicResource MeslyMutedTextBrush}" Margin="0,8,0,0" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Sürükle-bırak bilgisi -->
            <Border x:Name="DropZone" Margin="0,18,0,0" CornerRadius="8" BorderThickness="1.5" BorderBrush="{DynamicResource MeslyBorderBrush}" Background="{DynamicResource MeslyDropZoneBrush}" Padding="16,12">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="18" Foreground="{DynamicResource MeslyAccentBrush}" Margin="0,0,10,0" />
                    <TextBlock VerticalAlignment="Center" Foreground="{DynamicResource MeslyMutedTextBrush}"
                               Text="PDF, resim (JPG, PNG, TIFF) veya Office belgelerini bu pencereye sürükleyip bırakarak da açabilirsiniz." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
