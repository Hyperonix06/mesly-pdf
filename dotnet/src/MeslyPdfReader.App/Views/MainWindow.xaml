<ui:FluentWindow x:Class="MeslyPdfReader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MeslyPdfReader.App.ViewModels"
        xmlns:v="clr-namespace:MeslyPdfReader.App.Views"
        xmlns:c="clr-namespace:MeslyPdfReader.App.Controls"
        xmlns:core="clr-namespace:MeslyPdfReader.Core;assembly=MeslyPdfReader.Core"
        Title="Mesly PDF Reader" Width="1360" Height="880" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowCornerPreference="Round" AllowDrop="True" FontFamily="{StaticResource MeslyFont}"
        Icon="pack://application:,,,/Assets/icon.ico">
    <ui:FluentWindow.Resources>
        <Style x:Key="RibbonLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="RibbonIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RibbonPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="10,2,10,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource MeslyChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Başlık çubuğu -->
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Mesly PDF Reader" Height="40">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/icon_256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 1: Dosya menüsü + sekmeler + hızlı erişim (FineReader PDF düzeni) -->
        <Grid Grid.Row="1" x:Name="RibbonTabs" Margin="8,0,8,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button Style="{StaticResource FileMenuButton}" Click="OpenMenu_Click" ToolTip="Dosya menüsü" Margin="0,0,10,4">
                <Button.ContextMenu><ContextMenu><MenuItem Header="Yeni Görev" Command="{Binding ShowHomeCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Home24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="PDF belgesi aç…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"><MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Yeni PDF belgesi…" Command="{Binding CreateBlankCommand}" InputGestureText="Ctrl+N"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentAdd24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Görüntülerden PDF…" Command="{Binding CreateFromImagesCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ImageMultiple24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Tara…" Command="{Binding ScanToPdfCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ScanText24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="Kaydet" Command="{Binding ActiveTab.SaveCommand}" InputGestureText="Ctrl+S" IsEnabled="{Binding HasDocument}"><MenuItem.Icon><ui:SymbolIcon Symbol="Save24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Farklı kaydet…" Command="{Binding ActiveTab.SaveAsCommand}" InputGestureText="Ctrl+Shift+S" IsEnabled="{Binding HasDocument}"><MenuItem.Icon><ui:SymbolIcon Symbol="SaveCopy24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Dışa aktar" IsEnabled="{Binding HasDocument}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="16" /></MenuItem.Icon><MenuItem Header="Sayfaları görüntü olarak…" Command="{Binding ActiveTab.ExportImagesCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Image24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Metni TXT olarak…" Command="{Binding ActiveTab.ExportTextCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentText24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Sayfa aralığını ayrı PDF olarak…" Command="{Binding ActiveTab.ExtractPagesCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentArrowLeft24" FontSize="16" /></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="Yazdır…" Command="{Binding ActiveTab.PrintCommand}" InputGestureText="Ctrl+P" IsEnabled="{Binding HasDocument}"><MenuItem.Icon><ui:SymbolIcon Symbol="Print24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="PDF belgelerini birleştir…" Command="{Binding MergeCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Merge24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="PDF belgesini böl…" Command="{Binding SplitPdfCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSplit24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="Kapat" Command="{Binding CloseTabCommand}" CommandParameter="{x:Null}" InputGestureText="Ctrl+W" IsEnabled="{Binding HasDocument}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentDismiss24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Tümünü kapat" Command="{Binding CloseAllTabsCommand}" IsEnabled="{Binding HasDocument}"></MenuItem><Separator /><MenuItem Header="Ayarlar…" Command="{Binding OpenSettingsCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Settings24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Çıkış" Click="Exit_Click" InputGestureText="Alt+F4"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowExit20" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu>
                <StackPanel Orientation="Horizontal"><TextBlock Text="Dosya" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="6,2,0,0" Foreground="White" /></StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                <RadioButton Style="{StaticResource RibbonTabStyle}" Content="Belge" GroupName="rb"
                             IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Document}" />
                <RadioButton Style="{StaticResource RibbonTabStyle}" Content="Sayfaları Düzenle" GroupName="rb"
                             IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Organize}" />
                <RadioButton Style="{StaticResource RibbonTabStyle}" Content="İçeriği Düzenle" GroupName="rb"
                             IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=EditContent}" />
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,10,4" VerticalAlignment="Center" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding OpenCommand}" ToolTip="Aç (Ctrl+O)"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" /></Button>
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActiveTab.SaveCommand}" ToolTip="Kaydet (Ctrl+S)"><ui:SymbolIcon Symbol="Save24" FontSize="16" /></Button>
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActiveTab.PrintCommand}" ToolTip="Yazdır (Ctrl+P)"><ui:SymbolIcon Symbol="Print24" FontSize="16" /></Button>
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActiveTab.UndoCommand}" IsEnabled="{Binding ActiveTab.CanUndo, FallbackValue=False}" ToolTip="Geri al (Ctrl+Z)"><ui:SymbolIcon Symbol="ArrowUndo24" FontSize="16" /></Button>
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActiveTab.RedoCommand}" IsEnabled="{Binding ActiveTab.CanRedo, FallbackValue=False}" ToolTip="Yinele (Ctrl+Y)"><ui:SymbolIcon Symbol="ArrowRedo24" FontSize="16" /></Button>
            </StackPanel>
            <ui:TextBox Grid.Column="3" x:Name="QuickSearch" Width="240" Height="32" Margin="0,2,4,4" PlaceholderText="Belgede ara (Ctrl+F)"
                        Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}" KeyDown="QuickSearch_KeyDown"
                        Text="{Binding ActiveTab.SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True">
                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
            </ui:TextBox>
        </Grid>

        <!-- 2: Sekmenin araç çubuğu (tek satır) -->
        <Border Grid.Row="2" x:Name="RibbonBody" Margin="8,0,8,6" CornerRadius="8" Background="{DynamicResource MeslyPanelBrush}"
                BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="1" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
            <ScrollViewer x:Name="RibbonScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Ribbon_MouseWheel" Focusable="False">
            <Grid Height="44" Margin="6,0,6,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Ribbon, Converter={StaticResource EqualsToVis}, ConverterParameter=Document}">
                    <Button Style="{StaticResource TbButton}" Command="{Binding ShowHomeCommand}" ToolTip="Başlangıç ekranı (Yeni Görev)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Home24" FontSize="18" /><TextBlock Text="Yeni Görev" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.SetToolCommand}" CommandParameter="{x:Static c:ViewerTool.Select}" Tag="{Binding ActiveTab.Tool, Converter={StaticResource EqualsToBool}, ConverterParameter=Select}" ToolTip="Seçme aracı (V)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="CursorClick24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.SetToolCommand}" CommandParameter="{x:Static c:ViewerTool.Hand}" Tag="{Binding ActiveTab.Tool, Converter={StaticResource EqualsToBool}, ConverterParameter=Hand}" ToolTip="El aracı (H)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="HandLeft24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.CopySelectionCommand}" ToolTip="Seçili metni kopyala (Ctrl+C)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Copy24" FontSize="18" /></StackPanel></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.ZoomOutCommand}" ToolTip="Uzaklaştır (Ctrl+-)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ZoomOut24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.ZoomInCommand}" ToolTip="Yakınlaştır (Ctrl++)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ZoomIn24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.FitWidthCommand}" ToolTip="Genişliğe sığdır (Ctrl+2)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowAutofitWidth24" FontSize="18" /><TextBlock Text="Genişliğe sığdır" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.FitPageCommand}" ToolTip="Sayfaya sığdır (Ctrl+0)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PageFit24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Click="OpenMenu_Click" ToolTip="Sayfa düzeni, döndürme, tam ekran, karanlık okuma"><Button.ContextMenu><ContextMenu><MenuItem Header="Sürekli kaydırma" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.Continuous}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentOnePage24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Tek sayfa" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.SinglePage}"><MenuItem.Icon><ui:SymbolIcon Symbol="Document24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Çift sayfa" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.TwoPageContinuous}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Kitap görünümü" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.TwoPage}"><MenuItem.Icon><ui:SymbolIcon Symbol="BookOpen24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="Görünümü sola döndür" Command="{Binding ActiveTab.RotateViewLeftCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Görünümü sağa döndür" Command="{Binding ActiveTab.RotateViewRightCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="Tam ekran" Click="FullScreen_Click" InputGestureText="F11"><MenuItem.Icon><ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Karanlık okuma" Command="{Binding ActiveTab.ToggleDarkCommand}" InputGestureText="Ctrl+Shift+N"><MenuItem.Icon><ui:SymbolIcon Symbol="WeatherMoon24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Açık / koyu tema" Click="ToggleTheme_Click"><MenuItem.Icon><ui:SymbolIcon Symbol="DarkTheme24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="Özellikler paneli" Command="{Binding ActiveTab.TogglePropertiesCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="PanelRight24" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Eye24" FontSize="18" /><TextBlock Text="Görünüm" Margin="6,0,0,0" VerticalAlignment="Center" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.RecognizeTextCommand}" ToolTip="Taranmış sayfaların metnini tanı (OCR): aranabilir ve düzenlenebilir olur"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentSearch24" FontSize="18" /><TextBlock Text="Metni tanı" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.VerifyOcrCommand}" ToolTip="Düşük güvenle tanınan sözcükleri görüntüsüyle karşılaştırıp düzelt"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="TextGrammarCheckmark24" FontSize="18" /><TextBlock Text="Doğrula" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.AddBookmarkCommand}" ToolTip="Yer imi ekle (Ctrl+D)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="BookmarkAdd24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.GoToPagePromptCommand}" ToolTip="Sayfaya git (Ctrl+G)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentArrowRight24" FontSize="18" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Ribbon, Converter={StaticResource EqualsToVis}, ConverterParameter=Organize}">
                    <Button Style="{StaticResource TbButton}" Click="OpenMenu_Click" ToolTip="Boş sayfa, dosyadan veya tarayıcıdan sayfa ekle"><Button.ContextMenu><ContextMenu><MenuItem Header="Boş sayfa…" Command="{Binding ActiveTab.InsertBlankCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentAdd24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Dosyadan (PDF veya görüntü)…" Command="{Binding ActiveTab.InsertFromFileCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowImport24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Tarayıcıdan…" Command="{Binding ActiveTab.ScanInsertCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ScanText24" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentAdd24" FontSize="18" /><TextBlock Text="Sayfa ekle" Margin="6,0,0,0" VerticalAlignment="Center" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.DuplicatePagesCommand}" ToolTip="Seçili sayfaların kopyasını ekle"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentCopy24" FontSize="18" /><TextBlock Text="Çoğalt" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.DeletePagesCommand}" ToolTip="Seçili sayfaları sil (Delete)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" FontSize="18" /><TextBlock Text="Sil" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.RotatePagesLeftCommand}" ToolTip="Sola döndür (Ctrl+Shift+R)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.RotatePagesRightCommand}" ToolTip="Sağa döndür (Ctrl+R)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.MovePagesUpCommand}" ToolTip="Öne taşı"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowUp24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.MovePagesDownCommand}" ToolTip="Arkaya taşı"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowDown24" FontSize="18" /></StackPanel></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.CropPagesCommand}" ToolTip="Sayfa kenarlarını kırp"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Crop24" FontSize="18" /><TextBlock Text="Kırp" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.ResizePagesCommand}" ToolTip="Sayfa boyutunu değiştir (A4, A3, A5, özel)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Resize24" FontSize="18" /><TextBlock Text="Boyut" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.ExtractPagesCommand}" ToolTip="Sayfa aralığını yeni PDF olarak kaydet"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentArrowLeft24" FontSize="18" /><TextBlock Text="Ayıkla" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.SplitCommand}" ToolTip="Belgeyi birden çok dosyaya böl"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowSplit24" FontSize="18" /><TextBlock Text="Böl" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding MergeCommand}" ToolTip="Birden fazla PDF&#x27;yi birleştir"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Merge24" FontSize="18" /><TextBlock Text="Birleştir" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Ribbon, Converter={StaticResource EqualsToVis}, ConverterParameter=EditContent}">
                    <Button Style="{StaticResource TbIconButton}" Command="{Binding ActiveTab.SetToolCommand}" CommandParameter="{x:Static c:ViewerTool.Edit}" Tag="{Binding ActiveTab.Tool, Converter={StaticResource EqualsToBool}, ConverterParameter=Edit}" ToolTip="Metin ve görselleri düzenle (bu sekmede her zaman açık; Esc seçimi kaldırır)"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Edit24" FontSize="18" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Text}" ToolTip="Yeni metin bloğu: sayfaya tıklayın veya alan çizin"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="TextAddT24" FontSize="18" /><TextBlock Text="Metin ekle" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Click="OpenMenu_Click" ToolTip="Resim ekle veya seçili resmi değiştir"><Button.ContextMenu><ContextMenu><MenuItem Header="Resim ekle…" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Image}"><MenuItem.Icon><ui:SymbolIcon Symbol="ImageAdd24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Seçili resmi değiştir…" Command="{Binding ActiveTab.ReplaceSelectedImageCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ImageEdit24" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ImageAdd24" FontSize="18" /><TextBlock Text="Resim" Margin="6,0,0,0" VerticalAlignment="Center" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Click="OpenMenu_Click" ToolTip="Dikdörtgen, elips, çizgi veya ok çiz"><Button.ContextMenu><ContextMenu><MenuItem Header="Dikdörtgen" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Rectangle}"><MenuItem.Icon><ui:SymbolIcon Symbol="RectangleLandscape24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Elips" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Ellipse}"><MenuItem.Icon><ui:SymbolIcon Symbol="Circle24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Çizgi" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Line}"><MenuItem.Icon><ui:SymbolIcon Symbol="Line24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Ok" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Arrow}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowUpRight24" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Shapes24" FontSize="18" /><TextBlock Text="Şekil" Margin="6,0,0,0" VerticalAlignment="Center" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Click="OpenMenu_Click" ToolTip="Seçili öğeleri hizala (Ctrl ile birden çok seçin)"><Button.ContextMenu><ContextMenu><MenuItem Header="Sola" Command="{Binding ActiveTab.AlignSelectedCommand}" CommandParameter="{x:Static core:AlignMode.Left}"><MenuItem.Icon><ui:SymbolIcon Symbol="AlignLeft24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Yatayda ortala" Command="{Binding ActiveTab.AlignSelectedCommand}" CommandParameter="{x:Static core:AlignMode.CenterH}"><MenuItem.Icon><ui:SymbolIcon Symbol="AlignCenterHorizontal24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Sağa" Command="{Binding ActiveTab.AlignSelectedCommand}" CommandParameter="{x:Static core:AlignMode.Right}"><MenuItem.Icon><ui:SymbolIcon Symbol="AlignRight24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Üste" Command="{Binding ActiveTab.AlignSelectedCommand}" CommandParameter="{x:Static core:AlignMode.Top}"><MenuItem.Icon><ui:SymbolIcon Symbol="AlignTop24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Dikeyde ortala" Command="{Binding ActiveTab.AlignSelectedCommand}" CommandParameter="{x:Static core:AlignMode.Middle}"><MenuItem.Icon><ui:SymbolIcon Symbol="AlignCenterVertical24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Alta" Command="{Binding ActiveTab.AlignSelectedCommand}" CommandParameter="{x:Static core:AlignMode.Bottom}"><MenuItem.Icon><ui:SymbolIcon Symbol="AlignBottom24" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="AlignLeft24" FontSize="18" /><TextBlock Text="Hizala" Margin="6,0,0,0" VerticalAlignment="Center" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource TbButton}" Click="OpenMenu_Click" ToolTip="Filigran ekle veya kaldır"><Button.ContextMenu><ContextMenu><MenuItem Header="Filigran ekle…" Command="{Binding ActiveTab.AddWatermarkCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="DrawImage24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Filigranları kaldır" Command="{Binding ActiveTab.RemoveWatermarksCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Eraser24" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DrawImage24" FontSize="18" /><TextBlock Text="Filigran" Margin="6,0,0,0" VerticalAlignment="Center" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Click="OpenMenu_Click" ToolTip="Üstbilgi, altbilgi ve sayfa numaraları"><Button.ContextMenu><ContextMenu><MenuItem Header="Üstbilgi ve altbilgi ekle…" Command="{Binding ActiveTab.AddHeaderFooterCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentHeaderFooter24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Sayfa numarası ekle…" Command="{Binding ActiveTab.AddPageNumbersCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="NumberSymbol24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Üst/altbilgileri kaldır" Command="{Binding ActiveTab.RemoveHeaderFooterCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Eraser24" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentHeaderFooter24" FontSize="18" /><TextBlock Text="Üst/Altbilgi" Margin="6,0,0,0" VerticalAlignment="Center" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Click="OpenMenu_Click" ToolTip="Sayfa arka plan rengi"><Button.ContextMenu><ContextMenu><MenuItem Header="Arka plan rengi…" Command="{Binding ActiveTab.SetBackgroundCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="PaintBucket24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Arka planı kaldır" Command="{Binding ActiveTab.RemoveBackgroundCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Eraser24" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PaintBucket24" FontSize="18" /><TextBlock Text="Arka plan" Margin="6,0,0,0" VerticalAlignment="Center" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Click="OpenMenu_Click" ToolTip="Web bağlantısı ekle veya kaldır"><Button.ContextMenu><ContextMenu><MenuItem Header="Bağlantı ekle (alan çizin)" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Link}"><MenuItem.Icon><ui:SymbolIcon Symbol="Link24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Bağlantı kaldır (tıklayın)" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.RemoveLink}"><MenuItem.Icon><ui:SymbolIcon Symbol="LinkDismiss24" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Link24" FontSize="18" /><TextBlock Text="Bağlantı" Margin="6,0,0,0" VerticalAlignment="Center" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="5,1,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Border Style="{StaticResource TbSep}" />
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.CorrectImagesCommand}" ToolTip="Taranmış sayfaların eğikliğini, yönünü ve kenar gölgelerini düzelt"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ImageEdit24" FontSize="18" /><TextBlock Text="Eğikliği ve yönü düzelt" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                    <Button Style="{StaticResource TbButton}" Command="{Binding ActiveTab.RecognizeTextCommand}" ToolTip="Taranmış sayfanın metnini tanı; ardından düzenlenebilir"><StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentSearch24" FontSize="18" /><TextBlock Text="Metni tanı" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel></Button>
                </StackPanel>
            </Grid>
            </ScrollViewer>
        </Border>

        <!-- 3: Belge sekmeleri -->
        <Grid Grid.Row="3" x:Name="DocTabs" Margin="8,0,8,0">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource DocTabStyle}" GroupName="docs" IsChecked="{Binding IsHome, Mode=OneWay}" Command="{Binding ShowHomeCommand}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,8,0">
                            <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,8,0" />
                            <TextBlock Text="Başlangıç" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <ItemsControl ItemsSource="{Binding Tabs}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                                <RadioButton Style="{StaticResource DocTabStyle}" GroupName="docs" IsChecked="{Binding IsActive, Mode=OneWay}"
                                             Click="DocTab_Click" ToolTip="{Binding FilePath}" MouseDown="DocTab_MouseDown">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="16" Margin="0,0,8,0" Foreground="#E5484D" />
                                        <TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="180" />
                                        <TextBlock Grid.Column="2" Text=" •" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MeslyAccentBrush}"
                                                   Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" ToolTip="Kaydedilmemiş değişiklikler" />
                                        <Button Grid.Column="3" Style="{StaticResource ToolButtonStyle}" Width="24" Height="24" Margin="6,0,0,0" ToolTip="Kapat (Ctrl+W)"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <ui:SymbolIcon Symbol="Dismiss16" FontSize="12" />
                                        </Button>
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding OpenCommand}" ToolTip="Belge aç (Ctrl+O)" Margin="4,0,0,0" Width="30" Height="30">
                        <ui:SymbolIcon Symbol="Add24" FontSize="16" />
                    </Button>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 4: İçerik -->
        <Border Grid.Row="4" Background="{DynamicResource MeslyPanelBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="0,1,0,1">
            <Grid>
                <v:HomeView x:Name="Home" Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}" />
                <ItemsControl x:Name="DocumentHost" ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><Grid /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle>
                        <Style TargetType="ContentPresenter">
                            <Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolToVis}}" />
                        </Style>
                    </ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                            <v:DocumentView />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Genel meşgul katmanı -->
                <Border Background="#66000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                    <Border Background="{DynamicResource MeslyPanelBrush}" CornerRadius="12" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                        <StackPanel>
                            <TextBlock Text="{Binding BusyText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <ProgressBar Margin="0,14,0,0" Height="4" Value="{Binding BusyProgress}" IsIndeterminate="{Binding BusyIndeterminate}" />
                            <Button Content="İptal" HorizontalAlignment="Right" Margin="0,14,0,0" Command="{Binding CancelBusyCommand}" />
                        </StackPanel>
                    </Border>
                </Border>
            </Grid>
        </Border>

        <!-- 5: Durum çubuğu -->
        <Grid Grid.Row="5" x:Name="StatusBar" Height="30" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MeslyMutedTextBrush}" TextTrimming="CharacterEllipsis"
                       Text="{Binding StatusText}" Visibility="{Binding IsHome, Converter={StaticResource BoolToVis}}" />
            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MeslyMutedTextBrush}" TextTrimming="CharacterEllipsis"
                       Text="{Binding ActiveTab.StatusText}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,18,0" Foreground="{DynamicResource MeslyMutedTextBrush}" Text="{Binding ActiveTab.PageInfo}" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,18,0" Foreground="{DynamicResource MeslyMutedTextBrush}">
                    <Run Text="Sayfa" /> <Run Text="{Binding ActiveTab.PageNumber, Mode=OneWay}" /> <Run Text="/" /> <Run Text="{Binding ActiveTab.PageCount, Mode=OneWay}" />
                </TextBlock>
                <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,18,0" Foreground="{DynamicResource MeslyMutedTextBrush}" Text="{Binding ActiveTab.ZoomPercent}" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MeslyMutedTextBrush}" Text="{Binding ActiveTab.FileSizeText}" />
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
