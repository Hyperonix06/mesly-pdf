                                        <TextBlock Grid.Column="2" Text=" •" FontWeight="Bold" VerticalAlignment="Center" Foreground="{DynamicResource MeslyAccentBrush}" Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                                        <Button Grid.Column="3" Style="{StaticResource ToolButtonStyle}" Width="24" Height="24" Margin="6,0,0,0" ToolTip="Kapat (Ctrl+W)"
                                                Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"><ui:SymbolIcon Symbol="Dismiss16" FontSize="12" /></Button>
                                    </Grid>
                                </RadioButton>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
            <Border Grid.Row="3" Background="{DynamicResource MeslyPanelBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="0,1,0,0">
                <ItemsControl x:Name="DocumentHost" ItemsSource="{Binding Tabs}" Focusable="False">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><Grid /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Visibility" Value="{Binding IsActive, Converter={StaticResource BoolToVis}}" /></Style></ItemsControl.ItemContainerStyle>
                    <ItemsControl.ItemTemplate><DataTemplate DataType="{x:Type vm:DocumentViewModel}"><v:DocumentView /></DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- Genel meşgul katmanı -->
        <Border Grid.Row="1" Background="#66000000" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="{DynamicResource MeslyPanelBrush}" CornerRadius="12" Padding="28,22" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="360">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <ProgressBar Margin="0,14,0,0" Height="4" Value="{Binding BusyProgress}" IsIndeterminate="{Binding BusyIndeterminate}" />
                    <Button Content="İptal" HorizontalAlignment="Right" Margin="0,14,0,0" Command="{Binding CancelBusyCommand}" />
                </StackPanel>
            </Border>
        </Border>

        <!-- Durum çubuğu -->
        <Border Grid.Row="2" x:Name="StatusBar" Height="28" Background="{DynamicResource MeslyChromeBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MeslyMutedTextBrush}" TextTrimming="CharacterEllipsis"
                           Text="{Binding StatusText}" Visibility="{Binding IsShell, Converter={StaticResource BoolToVis}}" />
                <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MeslyMutedTextBrush}" TextTrimming="CharacterEllipsis"
                           Text="{Binding ActiveTab.StatusText}" Visibility="{Binding IsViewer, Converter={StaticResource BoolToVis}}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsViewer, Converter={StaticResource BoolToVis}}">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,18,0" Foreground="{DynamicResource MeslyMutedTextBrush}" Text="{Binding ActiveTab.PageInfo}" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,18,0" Foreground="{DynamicResource MeslyMutedTextBrush}">
                        <Run Text="Sayfa" /> <Run Text="{Binding ActiveTab.PageNumber, Mode=OneWay}" /> <Run Text="/" /> <Run Text="{Binding ActiveTab.PageCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock VerticalAlignment="Center" FontSize="12" Margin="0,0,18,0" Foreground="{DynamicResource MeslyMutedTextBrush}" Text="{Binding ActiveTab.ZoomPercent}" />
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource MeslyMutedTextBrush}" Text="{Binding ActiveTab.FileSizeText}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
