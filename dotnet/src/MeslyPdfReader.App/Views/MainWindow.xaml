<ui:FluentWindow x:Class="MeslyPdfReader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MeslyPdfReader.App.ViewModels"
        xmlns:v="clr-namespace:MeslyPdfReader.App.Views"
        xmlns:sc="clr-namespace:MeslyPdfReader.App.Views.Screens"
        xmlns:c="clr-namespace:MeslyPdfReader.App.Controls"
        xmlns:core="clr-namespace:MeslyPdfReader.Core;assembly=MeslyPdfReader.Core"
        Title="{Binding WindowTitle}" Width="1360" Height="880" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="None"
        WindowCornerPreference="Round" AllowDrop="True" FontFamily="{StaticResource MeslyFont}"
        Background="{DynamicResource MeslyPanelBrush}" Icon="pack://application:,,,/Assets/icon.ico">
    <ui:FluentWindow.Resources>
        <Style x:Key="RibbonLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="RibbonIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource MeslyPanelBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Başlık çubuğu: "Mesly Pdf Reader - <ekran / belge>" -->
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="{Binding WindowTitle}" Height="36">
            <ui:TitleBar.Icon><ui:ImageIcon Source="pack://application:,,,/Assets/mark_64.png" /></ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- ═══════ Uygulama ekranları: sol menü + içerik ═══════ -->
        <Grid Grid.Row="1" x:Name="Shell" Visibility="{Binding IsShell, Converter={StaticResource BoolToVis}}">
            <Grid.ColumnDefinitions><ColumnDefinition Width="210" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border x:Name="Sidebar" Background="{DynamicResource MeslyPanelBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="0,1,1,0">
                <DockPanel Margin="12,14,12,12">
                    <!-- Logo -->
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,20">
                        <Image Source="pack://application:,,,/Assets/mark_64.png" Width="40" Height="40" RenderOptions.BitmapScalingMode="HighQuality" />
                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Mesly" FontFamily="{StaticResource MeslyDisplayFont}" FontSize="21" FontWeight="Bold" Foreground="#1B2A4A" Margin="0,-4,0,-3" />
                            <TextBlock Text="Pdf Reader" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource MeslyAccentBrush}" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Ayarlar" Tag="Settings24" IsChecked="{Binding Screen, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Settings}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Settings}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Yardım" Tag="QuestionCircle24" IsChecked="{Binding Screen, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Help}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Help}" />
                    </StackPanel>
                    <StackPanel>
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Ana Sayfa" Tag="Home24" IsChecked="{Binding Screen, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Home}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Home}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="PDF Aç" Tag="FolderOpen24" IsChecked="{Binding Screen, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Documents}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Documents}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Dönüştür" Tag="ArrowSync24" IsChecked="{Binding Screen, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Convert}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Convert}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="OCR (Metin Tanıma)" Tag="ScanText24" IsChecked="{Binding Screen, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Ocr}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Ocr}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Araçlar" Tag="Toolbox24" IsChecked="{Binding Screen, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Tools}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Tools}" />
                        <RadioButton Style="{StaticResource NavItem}" GroupName="nav" Content="Tarama" Tag="Scan24" IsChecked="{Binding Screen, Mode=OneWay, Converter={StaticResource EqualsToBool}, ConverterParameter=Scan}" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Scan}" />
                        <!-- Açık belgeler: görüntüleyiciye dönüş -->
                        <StackPanel Margin="0,18,0,0" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="AÇIK BELGELER" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MeslyMutedTextBrush}" Margin="12,0,0,6" />
                            <ItemsControl ItemsSource="{Binding Tabs}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:DocumentViewModel}">
                                        <Button Style="{StaticResource ToolButtonStyle}" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Height="30" Padding="10,0" ToolTip="{Binding FilePath}"
                                                Command="{Binding DataContext.ShowDocumentCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal">
                                                <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="15" Foreground="{DynamicResource MeslyAccentBrush}" Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Title}" MaxWidth="130" TextTrimming="CharacterEllipsis" FontSize="12.5" VerticalAlignment="Center" />
                                                <TextBlock Text=" •" FontWeight="Bold" Foreground="{DynamicResource MeslyAccentBrush}" Visibility="{Binding IsModified, Converter={StaticResource BoolToVis}}" />
                                            </StackPanel>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource MeslyCanvasBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="0,1,0,0">
                <Grid x:Name="ScreenHost">
                    <sc:HomeScreen x:Name="Home" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=Home}" />
                    <sc:DocumentsScreen x:Name="DocumentsScreen" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=Documents}" />
                    <sc:ConvertScreen x:Name="ConvertScreen" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=Convert}" />
                    <sc:BatchScreen x:Name="BatchConvertScreen" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=BatchConvert}" />
                    <sc:OcrScreen x:Name="OcrScreen" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=Ocr}" />
                    <sc:OcrEditorScreen x:Name="OcrEditorScreen" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=OcrEditor}" />
                    <sc:PageManagerScreen x:Name="ToolsScreen" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=Tools}" />
                    <sc:ScanScreen x:Name="ScanScreen" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=Scan}" />
                    <sc:SettingsScreen x:Name="SettingsScreen" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=Settings}" />
                    <sc:HelpScreen x:Name="HelpScreen" Visibility="{Binding Screen, Converter={StaticResource EqualsToVis}, ConverterParameter=Help}" />
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════ Belge görüntüleyici / PDF düzenleme ═══════ -->
        <Grid Grid.Row="1" x:Name="ViewerArea" Visibility="{Binding IsViewer, Converter={StaticResource BoolToVis}}">
            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
            <!-- Sekme başlıkları -->
            <Grid Grid.Row="0" x:Name="RibbonTabs" Margin="8,0,8,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Button Style="{StaticResource FileMenuButton}" Click="OpenMenu_Click" ToolTip="Dosya menüsü" Margin="0,0,10,4">
                    <Button.ContextMenu><ContextMenu><MenuItem Header="Ana Sayfa" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Home}"><MenuItem.Icon><ui:SymbolIcon Symbol="Home24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Belgelerim" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Documents}"><MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="Aç…" Command="{Binding OpenCommand}" InputGestureText="Ctrl+O"><MenuItem.Icon><ui:SymbolIcon Symbol="FolderOpen24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Yeni PDF…" Command="{Binding CreateBlankCommand}" InputGestureText="Ctrl+N"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentAdd24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Görüntülerden PDF…" Command="{Binding CreateFromImagesCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ImageMultiple24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Office belgesinden PDF…" Command="{Binding OfficeToPdfCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentPdf24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Tara…" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Scan}"><MenuItem.Icon><ui:SymbolIcon Symbol="Scan24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="Kaydet" Command="{Binding ActiveTab.SaveCommand}" InputGestureText="Ctrl+S"><MenuItem.Icon><ui:SymbolIcon Symbol="Save24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Farklı kaydet…" Command="{Binding ActiveTab.SaveAsCommand}" InputGestureText="Ctrl+Shift+S"><MenuItem.Icon><ui:SymbolIcon Symbol="SaveCopy24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Dönüştür"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowSync24" FontSize="16" /></MenuItem.Icon><MenuItem Header="Microsoft Word (.docx)…" Command="{Binding ActiveTab.ConvertToWordCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentText24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Microsoft Excel (.xlsx)…" Command="{Binding ActiveTab.ConvertToExcelCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Table24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Microsoft PowerPoint (.pptx)…" Command="{Binding ActiveTab.ConvertToPowerPointCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="SlideMultiple24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="Resim (PNG, JPG, TIFF, BMP)…" Command="{Binding ActiveTab.ExportImagesCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="Image24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Metin (TXT)…" Command="{Binding ActiveTab.ExportTextCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="TextT24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Sayfa aralığını ayrı PDF olarak…" Command="{Binding ActiveTab.ExtractPagesCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentArrowLeft24" FontSize="16" /></MenuItem.Icon></MenuItem></MenuItem><MenuItem Header="PDF&#x27;yi sıkıştır…" Command="{Binding ActiveTab.CompressCommand}"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowMinimize24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Yazdır…" Command="{Binding ActiveTab.PrintCommand}" InputGestureText="Ctrl+P"><MenuItem.Icon><ui:SymbolIcon Symbol="Print24" FontSize="16" /></MenuItem.Icon></MenuItem><Separator /><MenuItem Header="Kapat" Command="{Binding CloseTabCommand}" CommandParameter="{x:Null}" InputGestureText="Ctrl+W"><MenuItem.Icon><ui:SymbolIcon Symbol="DocumentDismiss24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Tümünü kapat" Command="{Binding CloseAllTabsCommand}"></MenuItem><Separator /><MenuItem Header="Ayarlar" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppScreen.Settings}"><MenuItem.Icon><ui:SymbolIcon Symbol="Settings24" FontSize="16" /></MenuItem.Icon></MenuItem><MenuItem Header="Çıkış" Click="Exit_Click" InputGestureText="Alt+F4"><MenuItem.Icon><ui:SymbolIcon Symbol="ArrowExit20" FontSize="16" /></MenuItem.Icon></MenuItem></ContextMenu></Button.ContextMenu>
                    <StackPanel Orientation="Horizontal"><TextBlock Text="Dosya" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="6,2,0,0" Foreground="White" /></StackPanel>
                </Button>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVis}}">
<RadioButton Style="{StaticResource RibbonTabStyle}" Content="Giriş" GroupName="rb" IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Home}" />
<RadioButton Style="{StaticResource RibbonTabStyle}" Content="Görünüm" GroupName="rb" IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=View}" />
<RadioButton Style="{StaticResource RibbonTabStyle}" Content="Araçlar" GroupName="rb" IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Tools}" />
</StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}">
<RadioButton Style="{StaticResource RibbonTabStyle}" Content="Giriş" GroupName="rb" IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=EditHome}" />
<RadioButton Style="{StaticResource RibbonTabStyle}" Content="Düzenle" GroupName="rb" IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Edit}" />
<RadioButton Style="{StaticResource RibbonTabStyle}" Content="Açıklama" GroupName="rb" IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Annotate}" />
<RadioButton Style="{StaticResource RibbonTabStyle}" Content="İmza" GroupName="rb" IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Sign}" />
<RadioButton Style="{StaticResource RibbonTabStyle}" Content="Form" GroupName="rb" IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Form}" />
</StackPanel>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource SecondaryButton}" Height="30" Margin="0,0,10,4" Command="{Binding ExitEditModeCommand}"
                        Visibility="{Binding IsEditMode, Converter={StaticResource BoolToVis}}" ToolTip="PDF Düzenleme kipinden çık (Esc)">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Dismiss24" FontSize="14" Margin="0,0,6,0" /><TextBlock Text="Düzenlemeyi kapat" /></StackPanel>
                </Button>
                <ui:TextBox Grid.Column="3" x:Name="QuickSearch" Width="230" Height="32" Margin="0,2,4,4" PlaceholderText="Belgede ara (Ctrl+F)" KeyDown="QuickSearch_KeyDown"
                            Text="{Binding ActiveTab.SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True">
                    <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
                </ui:TextBox>
            </Grid>
            <!-- Şerit gövdesi -->
            <Border Grid.Row="1" x:Name="RibbonBody" Margin="8,0,8,6" CornerRadius="8" Background="{DynamicResource MeslyPanelBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="1">
                <ScrollViewer x:Name="RibbonScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Ribbon_MouseWheel" Focusable="False">
                    <Grid Height="66" Margin="6,0,6,0">
                        <Grid Visibility="{Binding IsEditMode, Converter={StaticResource BoolInvertVis}}">
<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Ribbon, Converter={StaticResource EqualsToVis}, ConverterParameter=Home}">
<RadioButton Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.SetToolCommand}" CommandParameter="{x:Static c:ViewerTool.Select}" ToolTip="Metin seçme aracı (V)" IsChecked="{Binding ActiveTab.Tool, Converter={StaticResource EqualsToBool}, ConverterParameter=Select}" GroupName="tools"><StackPanel><ui:SymbolIcon Symbol="Cursor24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Seç" Style="{StaticResource RibbonLabel}" /></StackPanel></RadioButton>
<RadioButton Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.SetToolCommand}" CommandParameter="{x:Static c:ViewerTool.Hand}" ToolTip="El aracı: sayfayı sürükle (H)" IsChecked="{Binding ActiveTab.Tool, Converter={StaticResource EqualsToBool}, ConverterParameter=Hand}" GroupName="tools"><StackPanel><ui:SymbolIcon Symbol="HandLeft24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="El" Style="{StaticResource RibbonLabel}" /></StackPanel></RadioButton>
<Border Style="{StaticResource RibbonSeparator}" />
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.PrintCommand}" ToolTip="Yazdır (Ctrl+P)"><StackPanel><ui:SymbolIcon Symbol="Print24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Yazdır" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.SaveCommand}" ToolTip="Kaydet (Ctrl+S)"><StackPanel><ui:SymbolIcon Symbol="Save24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Kaydet" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Border Style="{StaticResource RibbonSeparator}" />
<StackPanel VerticalAlignment="Center" Margin="6,0"><Button Style="{StaticResource SecondaryButton}" Height="30" MinWidth="86" Click="OpenMenu_Click" ToolTip="Yakınlaştırma oranı"><Button.ContextMenu><ContextMenu><MenuItem Header="%50" Command="{Binding ActiveTab.SetZoomPercentCommand}" CommandParameter="50"></MenuItem><MenuItem Header="%75" Command="{Binding ActiveTab.SetZoomPercentCommand}" CommandParameter="75"></MenuItem><MenuItem Header="%100" Command="{Binding ActiveTab.SetZoomPercentCommand}" CommandParameter="100"></MenuItem><MenuItem Header="%125" Command="{Binding ActiveTab.SetZoomPercentCommand}" CommandParameter="125"></MenuItem><MenuItem Header="%150" Command="{Binding ActiveTab.SetZoomPercentCommand}" CommandParameter="150"></MenuItem><MenuItem Header="%200" Command="{Binding ActiveTab.SetZoomPercentCommand}" CommandParameter="200"></MenuItem><MenuItem Header="%300" Command="{Binding ActiveTab.SetZoomPercentCommand}" CommandParameter="300"></MenuItem><MenuItem Header="%400" Command="{Binding ActiveTab.SetZoomPercentCommand}" CommandParameter="400"></MenuItem></ContextMenu></Button.ContextMenu><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding ActiveTab.ZoomPercent}" /><ui:SymbolIcon Symbol="ChevronDown12" FontSize="9" Margin="8,2,0,0" /></StackPanel></Button><TextBlock Text="Yakınlaştır" Style="{StaticResource RibbonLabel}" /></StackPanel>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.ZoomInCommand}" ToolTip="Yakınlaştır (Ctrl++)"><StackPanel><ui:SymbolIcon Symbol="ZoomIn24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Yakınlaştır" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.ZoomOutCommand}" ToolTip="Uzaklaştır (Ctrl+-)"><StackPanel><ui:SymbolIcon Symbol="ZoomOut24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Uzaklaştır" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.FitPageCommand}" ToolTip="Sayfaya sığdır (Ctrl+0)"><StackPanel><ui:SymbolIcon Symbol="PageFit24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Sayfaya sığdır" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.FitWidthCommand}" ToolTip="Genişliğe sığdır (Ctrl+2)"><StackPanel><ui:SymbolIcon Symbol="ArrowAutofitWidth24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Genişliğe sığdır" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Border Style="{StaticResource RibbonSeparator}" />
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.PreviousPageCommand}" ToolTip="Önceki sayfa (PageUp)"><StackPanel><ui:SymbolIcon Symbol="ChevronLeft24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Önceki" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<StackPanel VerticalAlignment="Center" Margin="6,0"><StackPanel Orientation="Horizontal"><TextBlock Text="Sayfa:" VerticalAlignment="Center" Margin="0,0,6,0" /><ui:TextBox Width="52" Height="30" Padding="6,4" Text="{Binding ActiveTab.PageNumber, UpdateSourceTrigger=LostFocus}" x:Name="PageBox" KeyDown="PageBox_KeyDown" ClearButtonEnabled="False" /><TextBlock VerticalAlignment="Center" Margin="6,0,0,0"><Run Text="/ " /><Run Text="{Binding ActiveTab.PageCount, Mode=OneWay}" /></TextBlock></StackPanel><TextBlock Text="Sayfaya git" Style="{StaticResource RibbonLabel}" /></StackPanel>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.NextPageCommand}" ToolTip="Sonraki sayfa (PageDown)"><StackPanel><ui:SymbolIcon Symbol="ChevronRight24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Sonraki" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Border Style="{StaticResource RibbonSeparator}" />
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.RotateViewLeftCommand}" ToolTip="Görünümü sola döndür"><StackPanel><ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Sola döndür" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.RotateViewRightCommand}" ToolTip="Görünümü sağa döndür"><StackPanel><ui:SymbolIcon Symbol="ArrowRotateClockwise24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Sağa döndür" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Border Style="{StaticResource RibbonSeparator}" />
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.CopySelectionCommand}" ToolTip="Seçili metni kopyala (Ctrl+C)"><StackPanel><ui:SymbolIcon Symbol="Copy24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Kopyala" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Click="FocusSearch_Click" ToolTip="Belgede ara (Ctrl+F)"><StackPanel><ui:SymbolIcon Symbol="Search24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Ara" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
</StackPanel>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Ribbon, Converter={StaticResource EqualsToVis}, ConverterParameter=View}">
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.SinglePage}" ToolTip="Tek sayfa görünümü"><StackPanel><ui:SymbolIcon Symbol="DocumentOnePage24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Tek sayfa" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.Continuous}" ToolTip="Sürekli kaydırma"><StackPanel><ui:SymbolIcon Symbol="DocumentOnePageMultiple24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Sürekli" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.TwoPageContinuous}" ToolTip="Kitap gibi iki sayfa yan yana (sürekli)"><StackPanel><ui:SymbolIcon Symbol="Book24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="İki sayfa" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Border Style="{StaticResource RibbonSeparator}" />
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.ToggleLeftPanelCommand}" ToolTip="Sayfa küçük resimleri panelini göster/gizle"><StackPanel><ui:SymbolIcon Symbol="PanelLeft24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Sayfa paneli" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.ShowPanelCommand}" CommandParameter="{x:Static vm:LeftPanelKind.Bookmarks}" ToolTip="Yer imleri paneli"><StackPanel><ui:SymbolIcon Symbol="Bookmark24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Yer imleri" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.ShowPanelCommand}" CommandParameter="{x:Static vm:LeftPanelKind.Search}" ToolTip="Arama sonuçları paneli"><StackPanel><ui:SymbolIcon Symbol="Search24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Arama paneli" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Border Style="{StaticResource RibbonSeparator}" />
<Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.ToggleDarkCommand}" ToolTip="Sayfaları koyu zeminde göster"><StackPanel><ui:SymbolIcon Symbol="WeatherMoon24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Karanlık okuma" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Click="ToggleTheme_Click" ToolTip="Açık / koyu tema"><StackPanel><ui:SymbolIcon Symbol="DarkTheme24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Tema" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
<Button Style="{StaticResource RibbonLarge}" Click="FullScreen_Click" ToolTip="Tam ekran (F11)"><StackPanel><ui:SymbolIcon Symbol="ArrowMaximize24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="Tam ekran" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
</StackPanel>
<StackPanel Orientation="Horizontal" VerticalAlignment="Center" Visibility="{Binding Ribbon, Converter={StaticResource EqualsToVis}, ConverterParameter=Tools}">
<Button Style="{StaticResource RibbonLarge}" Command="{Binding EnterEditModeCommand}" ToolTip="Metin, görsel, vurgulama, açıklama ve imza (Ctrl+E)"><StackPanel><ui:SymbolIcon Symbol="DocumentEdit24" Style="{StaticResource RibbonIcon}" Foreground="{DynamicResource MeslyAccentBrush}" /><TextBlock Text="PDF Düzenle" Style="{StaticResource RibbonLabel}" /></StackPanel></Button>
