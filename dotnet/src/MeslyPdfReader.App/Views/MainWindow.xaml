<ui:FluentWindow x:Class="MeslyPdfReader.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:vm="clr-namespace:MeslyPdfReader.App.ViewModels"
        xmlns:v="clr-namespace:MeslyPdfReader.App.Views"
        xmlns:c="clr-namespace:MeslyPdfReader.App.Controls"
        xmlns:core="clr-namespace:MeslyPdfReader.Core;assembly=MeslyPdfReader.Core"
        Title="Mesly PDF Reader" Width="1360" Height="880" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True" WindowBackdropType="Mica"
        WindowCornerPreference="Round" AllowDrop="True" FontFamily="{StaticResource MeslyFont}"
        Icon="pack://application:,,,/Assets/icon.ico">
    <ui:FluentWindow.Resources>
        <Style x:Key="RibbonLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextAlignment" Value="Center" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="RibbonIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="22" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="RibbonPanel" TargetType="StackPanel">
            <Setter Property="Orientation" Value="Horizontal" />
            <Setter Property="Margin" Value="10,2,10,4" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid x:Name="RootGrid" Background="{DynamicResource MeslyChromeBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 0: Başlık çubuğu -->
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" Title="Mesly PDF Reader" Height="40">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/icon_256.png" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- 1: Şerit sekmeleri + hızlı erişim -->
        <Grid Grid.Row="1" x:Name="RibbonTabs" Margin="8,0,8,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal">
                <RadioButton Style="{StaticResource RibbonTabStyle}" Content="Dosya" GroupName="rb"
                             IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=File}" />
                <RadioButton Style="{StaticResource RibbonTabStyle}" Content="Okuma" GroupName="rb"
                             Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}"
                             IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Read}" />
                <RadioButton Style="{StaticResource RibbonTabStyle}" Content="Düzenle" GroupName="rb"
                             Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}"
                             IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Edit}" />
                <RadioButton Style="{StaticResource RibbonTabStyle}" Content="Tanıma (OCR)" GroupName="rb"
                             Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}"
                             IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Ocr}" />
                <RadioButton Style="{StaticResource RibbonTabStyle}" Content="Sayfalar" GroupName="rb"
                             Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}"
                             IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Pages}" />
                <RadioButton Style="{StaticResource RibbonTabStyle}" Content="Dönüştür" GroupName="rb"
                             IsChecked="{Binding Ribbon, Converter={StaticResource EqualsToBool}, ConverterParameter=Convert}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,10,4" VerticalAlignment="Center" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActiveTab.SaveCommand}" ToolTip="Kaydet (Ctrl+S)"><ui:SymbolIcon Symbol="Save24" FontSize="16" /></Button>
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActiveTab.UndoCommand}" IsEnabled="{Binding ActiveTab.CanUndo, FallbackValue=False}" ToolTip="Geri al (Ctrl+Z)"><ui:SymbolIcon Symbol="ArrowUndo24" FontSize="16" /></Button>
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActiveTab.RedoCommand}" IsEnabled="{Binding ActiveTab.CanRedo, FallbackValue=False}" ToolTip="Yinele (Ctrl+Y)"><ui:SymbolIcon Symbol="ArrowRedo24" FontSize="16" /></Button>
                <Button Style="{StaticResource ToolButtonStyle}" Command="{Binding ActiveTab.PrintCommand}" ToolTip="Yazdır (Ctrl+P)"><ui:SymbolIcon Symbol="Print24" FontSize="16" /></Button>
            </StackPanel>
            <ui:TextBox Grid.Column="2" x:Name="QuickSearch" Width="260" Height="32" Margin="0,2,4,4" PlaceholderText="Belgede ara (Ctrl+F)"
                        Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}" KeyDown="QuickSearch_KeyDown"
                        Text="{Binding ActiveTab.SearchText, UpdateSourceTrigger=PropertyChanged}" ClearButtonEnabled="True">
                <ui:TextBox.Icon><ui:SymbolIcon Symbol="Search24" /></ui:TextBox.Icon>
            </ui:TextBox>
        </Grid>

        <!-- 2: Şerit içeriği (gruplu) -->
        <Border Grid.Row="2" x:Name="RibbonBody" Margin="8,0,8,6" CornerRadius="10" Background="{DynamicResource MeslyPanelBrush}"
                BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="1">
            <ScrollViewer x:Name="RibbonScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" PreviewMouseWheel="Ribbon_MouseWheel" Focusable="False">
            <Grid Height="92" Margin="4,0,4,0">
                <StackPanel Orientation="Horizontal" Visibility="{Binding Ribbon, Converter={StaticResource EqualsToVis}, ConverterParameter=File}">
<Border Style="{StaticResource RibbonGroup}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLarge}" Command="{Binding OpenCommand}" ToolTip="PDF veya görüntü aç (Ctrl+O)">
  <StackPanel><ui:SymbolIcon Symbol="FolderOpen24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Aç" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><Button Style="{StaticResource RibbonLarge}" Command="{Binding ScanToPdfCommand}" ToolTip="Tarayıcıdan yeni PDF: düz cam veya belge besleyici; sayfalar otomatik düzeltilir ve metin tanınır">
  <StackPanel><ui:SymbolIcon Symbol="ScanText24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Tara" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding CreateFromImagesCommand}" ToolTip="JPG, PNG, TIFF, BMP görüntülerinden PDF">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ImageMultiple24" FontSize="16" /><TextBlock Text="Görüntülerden PDF" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding CreateBlankCommand}" ToolTip="A4, A3, A5 veya özel boyutta boş PDF">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentAdd24" FontSize="16" /><TextBlock Text="Boş PDF" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding MergeCommand}" ToolTip="Birden fazla PDF&#x27;yi birleştir">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Merge24" FontSize="16" /><TextBlock Text="Birleştir" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Yeni" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.SaveCommand}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}" ToolTip="Kaydet (Ctrl+S)">
  <StackPanel><ui:SymbolIcon Symbol="Save24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Kaydet" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.SaveAsCommand}" ToolTip="Farklı kaydet (Ctrl+Shift+S)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="SaveCopy24" FontSize="16" /><TextBlock Text="Farklı kaydet" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.PrintCommand}" ToolTip="Yazdırma önizlemesi ve yazdır (Ctrl+P)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Print24" FontSize="16" /><TextBlock Text="Yazdır" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Kaydet" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding CloseTabCommand}" CommandParameter="{x:Null}" ToolTip="Geçerli belgeyi kapat (Ctrl+W)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentDismiss24" FontSize="16" /><TextBlock Text="Kapat" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding CloseAllTabsCommand}" ToolTip="Tüm belgeleri kapat">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="16" /><TextBlock Text="Tümünü kapat" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.TogglePropertiesCommand}" ToolTip="Belge ve sayfa özellikleri paneli">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Info24" FontSize="16" /><TextBlock Text="Belge özellikleri" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Belge" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
<Border Style="{StaticResource RibbonGroup}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLarge}" Command="{Binding OpenSettingsCommand}" ToolTip="Uygulama ayarları">
  <StackPanel><ui:SymbolIcon Symbol="Settings24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Ayarlar" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button></StackPanel>
  <TextBlock Grid.Row="1" Text="Uygulama" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Ribbon, Converter={StaticResource EqualsToVis}, ConverterParameter=Read}">
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.SetToolCommand}" CommandParameter="{x:Static c:ViewerTool.Select}" Tag="{Binding ActiveTab.Tool, Converter={StaticResource EqualsToBool}, ConverterParameter=Select}" ToolTip="Metin seçme aracı (V)">
  <StackPanel><ui:SymbolIcon Symbol="CursorClick24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Seç" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.SetToolCommand}" CommandParameter="{x:Static c:ViewerTool.Hand}" Tag="{Binding ActiveTab.Tool, Converter={StaticResource EqualsToBool}, ConverterParameter=Hand}" ToolTip="El aracı: sürükleyerek kaydır (H)">
  <StackPanel><ui:SymbolIcon Symbol="HandLeft24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="El" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.CopySelectionCommand}" ToolTip="Seçili metni kopyala (Ctrl+C)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Copy24" FontSize="16" /><TextBlock Text="Kopyala" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.SelectAllCommand}" ToolTip="Belgedeki tüm metni seç (Ctrl+A)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="SelectAllOn24" FontSize="16" /><TextBlock Text="Tümünü seç" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Click="FocusSearch_Click" ToolTip="Belgede ara (Ctrl+F)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Search24" FontSize="16" /><TextBlock Text="Ara" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Araç" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.FitWidthCommand}" ToolTip="Genişliğe sığdır (Ctrl+2)">
  <StackPanel><ui:SymbolIcon Symbol="ArrowAutofitWidth24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Genişliğe sığdır" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.FitPageCommand}" ToolTip="Sayfaya sığdır (Ctrl+0)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PageFit24" FontSize="16" /><TextBlock Text="Sayfaya sığdır" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.ActualSizeCommand}" ToolTip="%100 (Ctrl+1)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ZoomFit24" FontSize="16" /><TextBlock Text="Gerçek boyut" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.ZoomInCommand}" ToolTip="Yakınlaştır (Ctrl++)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ZoomIn24" FontSize="16" /><TextBlock Text="Yakınlaştır" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.ZoomOutCommand}" ToolTip="Uzaklaştır (Ctrl+-)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ZoomOut24" FontSize="16" /><TextBlock Text="Uzaklaştır" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Yakınlaştırma" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.Continuous}" ToolTip="Sürekli kaydırma">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentOnePage24" FontSize="16" /><TextBlock Text="Sürekli" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.SinglePage}" ToolTip="Tek sayfa">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Document24" FontSize="16" /><TextBlock Text="Tek sayfa" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.TwoPageContinuous}" ToolTip="Çift sayfa, sürekli kaydırma">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentMultiple24" FontSize="16" /><TextBlock Text="Çift sayfa" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.SetLayoutCommand}" CommandParameter="{x:Static c:PageLayoutMode.TwoPage}" ToolTip="İki sayfa, sayfa sayfa">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="BookOpen24" FontSize="16" /><TextBlock Text="Kitap" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.RotateViewLeftCommand}" ToolTip="Görünümü sola döndür (belge değişmez)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowRotateCounterclockwise24" FontSize="16" /><TextBlock Text="Görünümü sola" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.RotateViewRightCommand}" ToolTip="Görünümü sağa döndür (belge değişmez)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ArrowRotateClockwise24" FontSize="16" /><TextBlock Text="Görünümü sağa" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Sayfa düzeni" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.GoToPagePromptCommand}" ToolTip="Sayfaya git (Ctrl+G)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DocumentArrowRight24" FontSize="16" /><TextBlock Text="Sayfaya git" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.AddBookmarkCommand}" ToolTip="Geçerli sayfaya yer imi ekle (Ctrl+D)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="BookmarkAdd24" FontSize="16" /><TextBlock Text="Yer imi ekle" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.ShowPanelCommand}" CommandParameter="{x:Static vm:LeftPanelKind.Bookmarks}" ToolTip="Yer imleri paneli">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Bookmark24" FontSize="16" /><TextBlock Text="Yer imleri" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Gezinme" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLarge}" Click="FullScreen_Click" ToolTip="Tam ekran okuma (F11, çıkmak için Esc)">
  <StackPanel><ui:SymbolIcon Symbol="FullScreenMaximize24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Tam ekran" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.ToggleDarkCommand}" ToolTip="Karanlık okuma modu (Ctrl+Shift+N)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="WeatherMoon24" FontSize="16" /><TextBlock Text="Karanlık okuma" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Click="ToggleTheme_Click" ToolTip="Uygulama temasını değiştir">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="DarkTheme24" FontSize="16" /><TextBlock Text="Açık / koyu tema" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.TogglePropertiesCommand}" ToolTip="Özellikler paneli">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="PanelRight24" FontSize="16" /><TextBlock Text="Özellikler" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Ekran" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Visibility="{Binding Ribbon, Converter={StaticResource EqualsToVis}, ConverterParameter=Edit}">
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.ToggleEditToolCommand}" Tag="{Binding ActiveTab.Tool, Converter={StaticResource EqualsToBool}, ConverterParameter=Edit}" ToolTip="Sayfadaki metin, görsel ve şekilleri seçin, taşıyın, boyutlandırın; metne çift tıklayarak düzenleyin (E)">
  <StackPanel><ui:SymbolIcon Symbol="Edit24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Metin ve görsel düzenle" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.EditSelectedTextCommand}" ToolTip="Seçili paragrafın metnini düzenle (F2)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="TextEditStyle24" FontSize="16" /><TextBlock Text="Metni düzenle" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.DeleteSelectedCommand}" ToolTip="Seçili nesneleri sil (Delete)">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Delete24" FontSize="16" /><TextBlock Text="Sil" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.ReplaceSelectedImageCommand}" ToolTip="Seçili görseli başka bir görselle değiştir">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ImageEdit24" FontSize="16" /><TextBlock Text="Görseli değiştir" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Düzenleme" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
  <StackPanel Orientation="Horizontal"><Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Text}" ToolTip="Yeni metin kutusu: sayfaya tıklayın veya alan çizin">
  <StackPanel><ui:SymbolIcon Symbol="TextAddT24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Metin" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><Button Style="{StaticResource RibbonLarge}" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Image}" ToolTip="Sayfaya görsel ekle">
  <StackPanel><ui:SymbolIcon Symbol="ImageAdd24" FontSize="24" HorizontalAlignment="Center" /><TextBlock Text="Görsel" Style="{StaticResource RibbonLargeLabel}" /></StackPanel>
</Button><StackPanel VerticalAlignment="Top" Margin="2,1,2,0" MinWidth="96"><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.Link}" ToolTip="Web bağlantısı ekle: alanı çizin">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Link24" FontSize="16" /><TextBlock Text="Bağlantı" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button><Button Style="{StaticResource RibbonSmall}" Command="{Binding ActiveTab.PlaceCommand}" CommandParameter="{x:Static c:EditPlacement.RemoveLink}" ToolTip="Tıkladığınız bağlantıyı kaldır">
  <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="LinkDismiss24" FontSize="16" /><TextBlock Text="Bağlantı kaldır" Margin="6,0,0,0" VerticalAlignment="Center" /></StackPanel>
</Button></StackPanel></StackPanel>
  <TextBlock Grid.Row="1" Text="Ekle" Style="{StaticResource RibbonGroupCaption}" />
 </Grid>
</Border>
<Border Style="{StaticResource RibbonGroup}" Visibility="{Binding HasDocument, Converter={StaticResource BoolToVis}}">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
