<UserControl x:Class="MeslyPdfReader.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MeslyPdfReader.App.ViewModels"
             AllowDrop="True">
    <!-- FineReader “Yeni Görev” düzeni: solda bölümler (Aç, Tara, Son Kullanılanlar), sağda görevler, altta belge dili. -->
    <UserControl.Resources>
        <Style x:Key="NavItem" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Height" Value="44" />
            <Setter Property="Margin" Value="10,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bg" CornerRadius="8" Background="Transparent" Padding="14,0">
                            <Grid>
                                <Border x:Name="Bar" Width="3" HorizontalAlignment="Left" Margin="-14,10,0,10" CornerRadius="1.5" Background="{DynamicResource MeslyAccentBrush}" Visibility="Collapsed" />
                                <ContentPresenter VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource MeslyHoverBrush}" /></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MeslySelectedBrush}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TaskTile" TargetType="Button">
            <Setter Property="Width" Value="320" />
            <Setter Property="Height" Value="78" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg" CornerRadius="10" Background="{DynamicResource MeslyPanelBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="1" Padding="14,10">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="BorderBrush" Value="{DynamicResource MeslyAccentBrush}" />
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource MeslyHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bg" Property="Background" Value="{DynamicResource MeslySelectedBrush}" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TileIcon" TargetType="Border">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="44" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="Background" Value="{DynamicResource MeslyAccentSoftBrush}" />
        </Style>
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="TileDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Foreground" Value="{DynamicResource MeslyMutedTextBrush}" />
        </Style>
        <Style x:Key="GroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MeslyMutedTextBrush}" />
            <Setter Property="Margin" Value="0,4,0,10" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MeslyCanvasBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: bölümler -->
        <Border Background="{DynamicResource MeslyChromeBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="20,22,10,22">
                    <Image Source="pack://application:,,,/Assets/mark_64.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Yeni Görev" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Mesly PDF Reader" Style="{StaticResource MutedText}" FontSize="11.5" />
                    </StackPanel>
                </StackPanel>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource TbButton}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Margin="10,0,10,14"
                        Command="{Binding OpenSettingsCommand}" ToolTip="Uygulama ayarları">
                    <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="Settings24" FontSize="18" /><TextBlock Text="Ayarlar" Margin="10,0,0,0" /></StackPanel>
                </Button>
                <StackPanel>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="home" IsChecked="{Binding HomeSection, Converter={StaticResource EqualsToBool}, ConverterParameter=Open}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" /><TextBlock Text="Aç" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="home" IsChecked="{Binding HomeSection, Converter={StaticResource EqualsToBool}, ConverterParameter=Scan}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="ScanText24" FontSize="20" /><TextBlock Text="Tara" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                    <RadioButton Style="{StaticResource NavItem}" GroupName="home" IsChecked="{Binding HomeSection, Converter={StaticResource EqualsToBool}, ConverterParameter=Recent}">
                        <StackPanel Orientation="Horizontal"><ui:SymbolIcon Symbol="History24" FontSize="20" /><TextBlock Text="Son Kullanılanlar" Margin="12,0,0,0" VerticalAlignment="Center" /></StackPanel>
                    </RadioButton>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Sağ: görevler -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Aç -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HomeSection, Converter={StaticResource EqualsToVis}, ConverterParameter=Open}">
                <StackPanel Margin="34,26,20,20">
                    <TextBlock Text="PDF ile çalışma" Style="{StaticResource GroupTitle}" />
                    <WrapPanel x:Name="OpenTasks">
                        <Button Style="{StaticResource TaskTile}" Command="{Binding OpenCommand}">
                            <DockPanel><Border Style="{StaticResource TileIcon}"><ui:SymbolIcon Symbol="DocumentPdf24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="PDF Belgesi Aç" Style="{StaticResource TileTitle}" /><TextBlock Text="Okuyun, arayın, yazdırın, yer imi ekleyin" Style="{StaticResource TileDesc}" /></StackPanel></DockPanel>
                        </Button>
                        <Button Style="{StaticResource TaskTile}" Command="{Binding EditPdfCommand}">
                            <DockPanel><Border Style="{StaticResource TileIcon}"><ui:SymbolIcon Symbol="Edit24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="PDF Düzenle" Style="{StaticResource TileTitle}" /><TextBlock Text="Metin, resim, filigran, üst/altbilgi — İçeriği Düzenle'de açılır" Style="{StaticResource TileDesc}" /></StackPanel></DockPanel>
                        </Button>
                        <Button Style="{StaticResource TaskTile}" Command="{Binding CreateBlankCommand}">
                            <DockPanel><Border Style="{StaticResource TileIcon}"><ui:SymbolIcon Symbol="DocumentAdd24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Yeni PDF Belgesi" Style="{StaticResource TileTitle}" /><TextBlock Text="A4, A3, A5 veya özel boyutta boş belge" Style="{StaticResource TileDesc}" /></StackPanel></DockPanel>
                        </Button>
                    </WrapPanel>

                    <TextBlock Text="Dönüştürme ve birleştirme" Style="{StaticResource GroupTitle}" Margin="0,14,0,10" />
                    <WrapPanel>
                        <Button Style="{StaticResource TaskTile}" Command="{Binding OcrPdfCommand}">
                            <DockPanel><Border Style="{StaticResource TileIcon}"><ui:SymbolIcon Symbol="DocumentSearch24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Aranabilir PDF'ye Dönüştür" Style="{StaticResource TileTitle}" /><TextBlock Text="Taranmış PDF'nin metnini tanı (OCR); yön ve eğiklik düzelir" Style="{StaticResource TileDesc}" /></StackPanel></DockPanel>
                        </Button>
                        <Button Style="{StaticResource TaskTile}" Command="{Binding CreateFromImagesCommand}">
                            <DockPanel><Border Style="{StaticResource TileIcon}"><ui:SymbolIcon Symbol="ImageMultiple24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="Görüntülerden PDF" Style="{StaticResource TileTitle}" /><TextBlock Text="JPG, PNG, TIFF, BMP dosyalarından tek PDF" Style="{StaticResource TileDesc}" /></StackPanel></DockPanel>
                        </Button>
                        <Button Style="{StaticResource TaskTile}" Command="{Binding ConvertPdfCommand}">
                            <DockPanel><Border Style="{StaticResource TileIcon}"><ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="PDF'yi Görüntüye veya Metne" Style="{StaticResource TileTitle}" /><TextBlock Text="Sayfaları PNG, JPG, TIFF, BMP veya TXT olarak kaydet" Style="{StaticResource TileDesc}" /></StackPanel></DockPanel>
                        </Button>
                        <Button Style="{StaticResource TaskTile}" Command="{Binding MergeCommand}">
                            <DockPanel><Border Style="{StaticResource TileIcon}"><ui:SymbolIcon Symbol="Merge24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="PDF Belgelerini Birleştir" Style="{StaticResource TileTitle}" /><TextBlock Text="Birden fazla PDF'yi istediğiniz sırada tek belgede" Style="{StaticResource TileDesc}" /></StackPanel></DockPanel>
                        </Button>
                        <Button Style="{StaticResource TaskTile}" Command="{Binding SplitPdfCommand}">
                            <DockPanel><Border Style="{StaticResource TileIcon}"><ui:SymbolIcon Symbol="ArrowSplit24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="PDF Belgesini Böl" Style="{StaticResource TileTitle}" /><TextBlock Text="Sayfa sayısına, aralıklara veya tek/çift sayfalara göre" Style="{StaticResource TileDesc}" /></StackPanel></DockPanel>
                        </Button>
                    </WrapPanel>

                    <!-- Bırakma alanı -->
                    <Border x:Name="DropZone" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource MeslyBorderBrush}" HorizontalAlignment="Left"
                            Background="{DynamicResource MeslyDropZoneBrush}" Padding="20,14" Margin="0,8,14,0" Cursor="Hand" MouseLeftButtonUp="DropZone_Click"
                            Width="{Binding ActualWidth, ElementName=OpenTasks}">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" />
                            <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" FontSize="13">
                                <Run Text="Dosyaları buraya sürükleyip bırakın" FontWeight="SemiBold" /><Run Text="  ·  PDF'ler açılır, görüntülerden PDF oluşturulur" Foreground="{DynamicResource MeslyMutedTextBrush}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Tara -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HomeSection, Converter={StaticResource EqualsToVis}, ConverterParameter=Scan}">
                <StackPanel Margin="34,26,20,20">
                    <TextBlock Text="Tarayıcıdan" Style="{StaticResource GroupTitle}" />
                    <WrapPanel>
                        <Button Style="{StaticResource TaskTile}" Command="{Binding ScanToPdfCommand}">
                            <DockPanel><Border Style="{StaticResource TileIcon}"><ui:SymbolIcon Symbol="ScanText24" FontSize="24" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                                <StackPanel VerticalAlignment="Center"><TextBlock Text="PDF Belgesine Tara" Style="{StaticResource TileTitle}" /><TextBlock Text="Düz cam veya belge besleyici (tek / çift taraflı)" Style="{StaticResource TileDesc}" /></StackPanel></DockPanel>
                        </Button>
                    </WrapPanel>
                    <Border Background="{DynamicResource MeslyPanelBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18,14" Margin="0,6,14,0" MaxWidth="660" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Text="Tarama sonrasında otomatik olarak" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBlock Style="{StaticResource TileDesc}" FontSize="12.5" Text="• Yan veya ters gelen sayfalar metne bakılarak dik çevrilir, eğiklik düzeltilir, kenar gölgeleri temizlenir." />
                            <TextBlock Style="{StaticResource TileDesc}" FontSize="12.5" Text="• Metin tanınır: PDF aranabilir, kopyalanabilir ve düzenlenebilir olur (aşağıdaki belge dilleriyle)." />
                            <TextBlock Style="{StaticResource TileDesc}" FontSize="12.5" Text="• Her ikisi de tarama penceresinden kapatılabilir. Tarama ve tanıma bu bilgisayarda yapılır." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Son Kullanılanlar -->
            <Grid Margin="34,26,34,16" Visibility="{Binding HomeSection, Converter={StaticResource EqualsToVis}, ConverterParameter=Recent}">
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Grid>
                    <TextBlock Text="Son açılan belgeler" Style="{StaticResource GroupTitle}" />
                    <Button HorizontalAlignment="Right" Style="{StaticResource ToolButtonStyle}" Width="auto" Padding="8,0" Command="{Binding ClearRecentCommand}"
                            ToolTip="Sabitlenmemiş son dosyaları listeden kaldır" Visibility="{Binding Recent.Count, Converter={StaticResource PositiveToVisible}}">
                        <TextBlock Text="Listeyi temizle" Margin="8,0" FontSize="12" />
                    </Button>
                </Grid>
                <Border Grid.Row="1" Background="{DynamicResource MeslyPanelBrush}" CornerRadius="10" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="1" Padding="10,8">
                    <Grid>
                        <TextBlock Text="Henüz belge açmadınız. “Aç” bölümünden bir PDF açın veya pencereye sürükleyip bırakın."
                                   Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="8,6,0,0"
                                   Visibility="{Binding Recent.Count, Converter={StaticResource ZeroToVisible}}" />
                        <ListBox x:Name="RecentList" ItemsSource="{Binding Recent}" ItemContainerStyle="{StaticResource ListItemPlain}"
                                 BorderThickness="0" Background="Transparent" MouseDoubleClick="Recent_DoubleClick" KeyDown="Recent_KeyDown"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                            <ListBox.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:RecentItem}">
                                    <Grid Background="Transparent" ToolTip="{Binding File.Path}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="26" Foreground="#E5484D" Margin="0,0,12,0" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Style="{StaticResource MutedText}">
                                                <Run Text="{Binding Info, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding Folder, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="bulunamadı" Foreground="IndianRed" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                                       Visibility="{Binding Exists, Converter={StaticResource BoolInvertVis}}" />
                                            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Sabitle / sabitlemeyi kaldır"
                                                    Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Pin24" FontSize="16" Filled="{Binding Pinned}" />
                                            </Button>
                                            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Klasörde göster"
                                                    Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Folder24" FontSize="16" />
                                            </Button>
                                            <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Listeden kaldır (dosya silinmez)"
                                                    Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Dismiss16" FontSize="13" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <!-- Alt çubuk: belge dilleri (FineReader “Belge dilleri”) -->
            <Border Grid.Row="1" Background="{DynamicResource MeslyChromeBrush}" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="0,1,0,0" Padding="34,8">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Belge dilleri:" VerticalAlignment="Center" Margin="0,0,10,0" />
                    <ComboBox Width="210" SelectedIndex="{Binding OcrLanguageIndex}" ToolTip="Metin tanıma (OCR) ve taramada kullanılacak diller">
                        <ComboBoxItem Content="Türkçe + İngilizce" />
                        <ComboBoxItem Content="Türkçe" />
                        <ComboBoxItem Content="İngilizce" />
                    </ComboBox>
                    <TextBlock Text="Tanıma tamamen bu bilgisayarda yapılır; belgeler hiçbir yere gönderilmez." Style="{StaticResource MutedText}" VerticalAlignment="Center" Margin="16,0,0,0" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
