<UserControl x:Class="MeslyPdfReader.App.Views.HomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:MeslyPdfReader.App.ViewModels"
             AllowDrop="True">
    <UserControl.Resources>
        <Style x:Key="ActionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,2" />
        </Style>
        <Style x:Key="ActionDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource MeslyMutedTextBrush}" />
        </Style>
        <Style x:Key="ActionIconBox" TargetType="Border">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Background" Value="{DynamicResource MeslyAccentSoftBrush}" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource MeslyCanvasBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="40,30,40,30" MaxWidth="1240">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Başlık -->
                <StackPanel Orientation="Horizontal">
                    <Image Source="pack://application:,,,/Assets/icon_256.png" Width="52" Height="52" RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Mesly PDF Reader" FontSize="26" FontWeight="SemiBold" FontFamily="{StaticResource MeslyDisplayFont}" />
                        <TextBlock Text="PDF görüntüleme, sayfa yönetimi ve dönüştürme — tamamen çevrimdışı" Style="{StaticResource MutedText}" FontSize="13" />
                    </StackPanel>
                </StackPanel>

                <!-- Hızlı işlemler -->
                <TextBlock Grid.Row="1" Text="Hızlı işlemler" Style="{StaticResource SectionTitle}" FontSize="15" Margin="0,28,0,12" />
                <UniformGrid Grid.Row="2" Columns="3" x:Name="Actions">
                    <Button Style="{StaticResource ActionCardStyle}" Command="{Binding OpenCommand}">
                        <StackPanel>
                            <Border Style="{StaticResource ActionIconBox}"><ui:SymbolIcon Symbol="FolderOpen24" FontSize="22" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                            <TextBlock Text="PDF aç" Style="{StaticResource ActionTitle}" />
                            <TextBlock Text="Bir veya birden çok PDF'yi sekmelerde açın." Style="{StaticResource ActionDesc}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardStyle}" Command="{Binding CreateFromImagesCommand}">
                        <StackPanel>
                            <Border Style="{StaticResource ActionIconBox}"><ui:SymbolIcon Symbol="ImageMultiple24" FontSize="22" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                            <TextBlock Text="PDF oluştur" Style="{StaticResource ActionTitle}" />
                            <TextBlock Text="JPG, PNG, TIFF ve BMP görüntülerinden tek bir PDF oluşturun." Style="{StaticResource ActionDesc}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardStyle}" Command="{Binding MergeCommand}">
                        <StackPanel>
                            <Border Style="{StaticResource ActionIconBox}"><ui:SymbolIcon Symbol="Merge24" FontSize="22" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                            <TextBlock Text="Belgeleri birleştir" Style="{StaticResource ActionTitle}" />
                            <TextBlock Text="Birden fazla PDF'yi istediğiniz sırada ve sayfa aralığıyla birleştirin." Style="{StaticResource ActionDesc}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardStyle}" Command="{Binding ConvertPdfCommand}">
                        <StackPanel>
                            <Border Style="{StaticResource ActionIconBox}"><ui:SymbolIcon Symbol="ArrowExportLtr24" FontSize="22" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                            <TextBlock Text="PDF dönüştür" Style="{StaticResource ActionTitle}" />
                            <TextBlock Text="Sayfaları PNG, JPG, TIFF, BMP görüntüye veya metne (TXT) dönüştürün." Style="{StaticResource ActionDesc}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardStyle}" Command="{Binding SplitPdfCommand}">
                        <StackPanel>
                            <Border Style="{StaticResource ActionIconBox}"><ui:SymbolIcon Symbol="ArrowSplit24" FontSize="22" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                            <TextBlock Text="PDF'yi böl" Style="{StaticResource ActionTitle}" />
                            <TextBlock Text="Sayfa sayısına, aralıklara veya tek/çift sayfalara göre ayrı dosyalara bölün." Style="{StaticResource ActionDesc}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ActionCardStyle}" Command="{Binding CreateBlankCommand}">
                        <StackPanel>
                            <Border Style="{StaticResource ActionIconBox}"><ui:SymbolIcon Symbol="DocumentAdd24" FontSize="22" Foreground="{DynamicResource MeslyAccentBrush}" /></Border>
                            <TextBlock Text="Boş PDF" Style="{StaticResource ActionTitle}" />
                            <TextBlock Text="A4, A3, A5 veya özel boyutta boş sayfalı yeni bir belge başlatın." Style="{StaticResource ActionDesc}" />
                        </StackPanel>
                    </Button>
                </UniformGrid>

                <!-- Son belgeler + bırakma alanı -->
                <Grid Grid.Row="3" Margin="0,20,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="20" />
                        <ColumnDefinition Width="320" />
                    </Grid.ColumnDefinitions>

                    <Border Background="{DynamicResource MeslyPanelBrush}" CornerRadius="12" BorderBrush="{DynamicResource MeslyBorderBrush}" BorderThickness="1" Padding="18,16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Son açılan belgeler" Style="{StaticResource SectionTitle}" FontSize="15" />
                                <Button HorizontalAlignment="Right" Style="{StaticResource ToolButtonStyle}" Width="auto" Padding="8,0" Command="{Binding ClearRecentCommand}"
                                        ToolTip="Sabitlenmemiş son dosyaları listeden kaldır" Visibility="{Binding Recent.Count, Converter={StaticResource PositiveToVisible}}">
                                    <TextBlock Text="Temizle" Margin="8,0" FontSize="12" />
                                </Button>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="Henüz belge açmadınız. Bir PDF'yi bu pencereye sürükleyin ya da “PDF aç”a tıklayın."
                                       Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,6,0,0"
                                       Visibility="{Binding Recent.Count, Converter={StaticResource ZeroToVisible}}" />
                            <ListBox Grid.Row="1" x:Name="RecentList" ItemsSource="{Binding Recent}" ItemContainerStyle="{StaticResource ListItemPlain}"
                                     BorderThickness="0" Background="Transparent" MinHeight="120" MouseDoubleClick="Recent_DoubleClick" KeyDown="Recent_KeyDown"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type vm:RecentItem}">
                                        <Grid Background="Transparent" ToolTip="{Binding File.Path}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="26" Foreground="#E5484D" Margin="0,0,12,0" VerticalAlignment="Center" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontSize="13.5" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Style="{StaticResource MutedText}">
                                                    <Run Text="{Binding Info, Mode=OneWay}" /> <Run Text=" · " /> <Run Text="{Binding Folder, Mode=OneWay}" />
                                                </TextBlock>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="bulunamadı" Foreground="IndianRed" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                                           Visibility="{Binding Exists, Converter={StaticResource BoolInvertVis}}" />
                                                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Sabitle / sabitlemeyi kaldır"
                                                        Command="{Binding DataContext.TogglePinCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Pin24" FontSize="16" Filled="{Binding Pinned}" />
                                                </Button>
                                                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Klasörde göster"
                                                        Command="{Binding DataContext.OpenContainingFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Folder24" FontSize="16" />
                                                </Button>
                                                <Button Style="{StaticResource ToolButtonStyle}" ToolTip="Listeden kaldır (dosya silinmez)"
                                                        Command="{Binding DataContext.RemoveRecentCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}">
                                                    <ui:SymbolIcon Symbol="Dismiss16" FontSize="13" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Bırakma alanı -->
                    <Border Grid.Column="2" x:Name="DropZone" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource MeslyBorderBrush}"
                            Background="{DynamicResource MeslyDropZoneBrush}" Padding="24" MinHeight="220" Cursor="Hand" MouseLeftButtonUp="DropZone_Click">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <ui:SymbolIcon Symbol="ArrowUpload24" FontSize="38" Foreground="{DynamicResource MeslyAccentBrush}" HorizontalAlignment="Center" />
                            <TextBlock Text="Dosyaları buraya bırakın" FontSize="15" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                            <TextBlock Text="PDF'ler sekmede açılır; görüntülerden yeni PDF oluşturulur." Style="{StaticResource ActionDesc}" TextAlignment="Center" />
                            <TextBlock Text="veya tıklayıp dosya seçin" Style="{StaticResource ActionDesc}" TextAlignment="Center" Margin="0,8,0,0" Foreground="{DynamicResource MeslyAccentBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
