<Project>
  <ItemGroup>
    <!-- PDF motoru: PDFium (Apache-2.0 / BSD-3) -->
    <PackageVersion Include="bblanchon.PDFium.Win32" Version="159.0.8152" />
    <PackageVersion Include="bblanchon.PDFium.Linux" Version="159.0.8152" />
    <!-- PDF yapısı: yer imi yazma (MIT) -->
    <PackageVersion Include="PDFsharp" Version="6.2.4" />
    <!-- PDFsharp'ın getirdiği açıklı sürümü güncel sürümle değiştir -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.15" />
    <!-- OCR: yalnızca Windows x64 yerel Tesseract 5 / Leptonica DLL'leri (Apache-2.0) -->
    <PackageVersion Include="Tesseract" Version="5.2.0" />
    <!-- Arayüz (MIT) -->
    <PackageVersion Include="WPF-UI" Version="4.3.0" />
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <!-- Veri (MIT) -->
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.15" />
    <!-- Test (Apache-2.0 / MIT) -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>
</Project>
